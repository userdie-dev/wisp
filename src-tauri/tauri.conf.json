{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "wisp",
  "version": "0.2.2",
  "identifier": "com.vadimov.wisp",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Wisp",
        "width": 1200,
        "height": 800,
        "minWidth": 640,
        "minHeight": 400,
        "transparent": true,
        "decorations": false,
        "titleBarStyle": "Overlay",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/userdie-dev/wisp/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDlGQjI1RjQ1RDNBNTFBRjkKUldUNUdxWFRSVit5bjVFeUQ3aTEyKzQvaFQwNS9lQmVNTnlIRUxSZ1kwcFI3SWo2R3VWanZkUGQK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
