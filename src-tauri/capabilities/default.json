{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capabilities for the main window: core window/app APIs plus the store plugin used directly from the frontend for history/bookmarks/settings.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "store:default",
    "updater:default",
    "process:allow-restart",
    "core:window:allow-close",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-is-maximized",
    "core:window:allow-start-dragging",
    "dialog:allow-open",
    {
      "identifier": "opener:allow-open-path",
      "allow": [{ "path": "$DOWNLOAD/**" }, { "path": "$HOME/**" }]
    },
    {
      "identifier": "opener:allow-reveal-item-in-dir",
      "allow": [{ "path": "$DOWNLOAD/**" }, { "path": "$HOME/**" }]
    }
  ]
}
